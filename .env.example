# ====== DashScope / OpenAI-compatible API ======
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ====== Models ======
LLM_MODEL=qwen3.6-flash
EMBEDDING_MODEL=text-embedding-v4
RERANKER_MODEL=qwen3-vl-rerank
TEMPERATURE=0

# ====== Redis hot memory cache, optional ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=86400

# ====== MySQL metadata store, required ======
# Used for knowledge bases, documents, indexing tasks, and conversation cold storage.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kbzhy

# ====== Reranker method: model / llm / keyword ======
RERANK_METHOD=model

# ====== Core retrieval pipeline v2 ======
TOKEN_ENCODING=cl100k_base
VECTOR_FETCH_K=30
BM25_FETCH_K=30
RRF_K=60
RRF_CANDIDATE_K=40
RERANK_CANDIDATE_K=30
MODEL_RERANK_THRESHOLD=0.35
KEYWORD_RERANK_THRESHOLD=0

# ====== Context assembly ======
CONTEXT_PER_DOCUMENT_LIMIT=3
CONTEXT_NEIGHBOR_WINDOW=1
CONTEXT_SINGLE_SOURCE_TOKEN_BUDGET=2000
